# ============================================================
# Token Flex Dashboard — Environment Variables
# ============================================================

# --- Client daemon ---
ANTHROPIC_API_KEY=sk-ant-...          # Anthropic API Key (로컬에만 보관)
TOKENFLEX_USER_ID=my_github_handle    # 대시보드에 표시될 유저 ID
TOKENFLEX_SERVER=http://localhost:8000 # 중앙 서버 URL
TOKENFLEX_INTERVAL=600                # 보고 주기 (초, 기본 600 = 10분)

# --- Server ---
TOKENFLEX_DB=tokenflex.db             # SQLite DB 파일 경로
TOKENFLEX_OWNER=your_user_id          # 그룹장 user_id (최초 자동 등록)

# --- Telegram bot (선택, 미설정 시 봇 비활성) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...  # @BotFather에서 발급받은 토큰
TELEGRAM_CHAT_ID=-100123456789        # 알림을 보낼 단톡방 chat_id
